# App
APP_ENV=development
APP_NAME=Paytm Sahaayak
FRONTEND_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET=documents

# Sarvam
SARVAM_API_KEY=your_sarvam_key

# Gemini OCR fallback
GEMINI_API_KEY=your_gemini_key
GEMINI_OCR_MODEL=gemini-3.8-flash
OCR_PROVIDER_ORDER=sarvam,gemini

# Local multilingual embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SARVAM_JOB_TIMEOUT_SECONDS=180

# Cognee
COGNEE_API_KEY=your_cognee_key
COGNEE_BASE_URL=your_cognee_url

# n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/sahaayak-case-event
N8N_CALLBACK_SECRET=hackathon-demo-secret

# Optional embedding / LLM provider
OPENAI_API_KEY=your_key
COHERE_API_KEY=your_key
